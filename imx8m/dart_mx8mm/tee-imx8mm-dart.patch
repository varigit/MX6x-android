From e61bc92bd5a5830d1e63661f7273d46e7790392d Mon Sep 17 00:00:00 2001
From: Marius Bagassien <marius.b@variscite.com>
Date: Thu, 29 Oct 2026 15:43:52 +0100
Subject: [PATCH] soc: imx8mm: use the DART-MX8M-MINI console UART for Trusty

The i.MX8MM Trusty target prints its log on UART2, the NXP EVK console,
and waits for the transmitter to be empty after every character. On
DART-MX8M-MINI, UART2 is not set up before Trusty runs, so Trusty hangs
on its first log line.

Use UART1 (0x30860000), the DART-MX8M-MINI console UART, as on the Variscite
Android 14 and 15 Trusty builds.

Signed-off-by: Marius Bagassien <marius.b@variscite.com>
---
 platform/imx/soc/imx8mm/include/imx-regs.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/platform/imx/soc/imx8mm/include/imx-regs.h b/platform/imx/soc/imx8mm/include/imx-regs.h
index b52403c..7bdecc9 100644
--- a/platform/imx/soc/imx8mm/include/imx-regs.h
+++ b/platform/imx/soc/imx8mm/include/imx-regs.h
@@ -41,7 +41,7 @@
 #define CONFIG_UART3_BASE 0x30880000
 #define CONFIG_UART4_BASE 0x30A60000
 
-#define CONFIG_CONSOLE_TTY_BASE CONFIG_UART2_BASE
+#define CONFIG_CONSOLE_TTY_BASE CONFIG_UART1_BASE
 
 #define CONFIG_CONSOLE_TTY_VIRT (0xFFFFFFFF00000000 + CONFIG_CONSOLE_TTY_BASE)
 #define MACH_IMX8MM
-- 
2.43.0

