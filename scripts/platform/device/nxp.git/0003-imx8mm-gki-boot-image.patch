From 68e459d3af522a34f99403bb3308348abf904150 Mon Sep 17 00:00:00 2001
From: Marius Bagassien <marius.b@variscite.com>
Date: Thu, 22 Oct 2026 10:13:22 +0200
Subject: [PATCH] build: support i.MX8MM products in derivative device
 repositories

Include i.MX8MM derivatives in the boot-image step of the in-tree
kernel flow, as is already done for i.MX8MP, so that both keep the
first kernel build as boot-imx.img and rebuild boot.img the same way.

Signed-off-by: Marius Bagassien <marius.b@variscite.com>
---
 common/tools/imx-make.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/tools/imx-make.sh b/common/tools/imx-make.sh
index 540e040b..25a2b57b 100755
--- a/common/tools/imx-make.sh
+++ b/common/tools/imx-make.sh
@@ -638,7 +638,7 @@ if [ ${build_android_flag} -eq 1 ] || [ ${build_whole_android_flag} -eq 1 ]; the
         if [ -n "${build_bootimage}" ] || [ ${build_whole_android_flag} -eq 1 ]; then
             if [[ ${TARGET_PRODUCT} == *8mp* ]] || [ ${TARGET_PRODUCT} = "evk_8mn" ] \
             || [ ${TARGET_PRODUCT} = "evk_8ulp" ] || [ ${TARGET_PRODUCT} = "mek_8q" ] \
-            || [ ${TARGET_PRODUCT} = "evk_8mm" ] || [ ${TARGET_PRODUCT} = "evk_8mq" ] \
+            || [[ ${TARGET_PRODUCT} == *8mm* ]] || [ ${TARGET_PRODUCT} = "evk_8mq" ] \
             || [ ${TARGET_PRODUCT} = "evk_95" ] || [ ${TARGET_PRODUCT} = "evk_952" ] ; then
                 if [ ${enable_gki} -eq 1 ]; then
                     mv ${OUT}/boot.img ${OUT}/boot-imx.img
