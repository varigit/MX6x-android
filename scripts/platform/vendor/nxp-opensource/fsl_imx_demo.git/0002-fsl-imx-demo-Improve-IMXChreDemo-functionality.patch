+    private void updateNanoAppState() {
+        if (mContextHubManager == null) {
+            return;
+        }
+
+        List<ContextHubInfo> info = mContextHubManager.getContextHubs();
+
+        if (info != null && !info.isEmpty()) {
+            mContextHubInfo = info.get(0);
+
+            if (mContextHubInfo == null) {
+                printToScreen("Context Hub Info is null", true);
+                return;
+            }
+
+            ContextHubTransaction<List<NanoAppState>> transaction = mContextHubManager.queryNanoApps(mContextHubInfo);
+
+            try {
+                ContextHubTransaction.Response<List<NanoAppState>> response =
+                    transaction.waitForResponse(QUERY_NANOAPPS_TIMEOUT_SECONDS, TimeUnit.SECONDS);
+
+                if (response != null && response.getResult() == ContextHubTransaction.RESULT_SUCCESS) {
+                    mNanoappStateList = response.getContents();
+
+                    if (mNanoappStateList == null || mNanoappStateList.isEmpty()) {
+                        printToScreen("No loadable nanoapps running in CHRE", false);
+                    }
+                } else {
+                    int err = (response != null) ? response.getResult() : -1;
+                    printToScreen("Nanoapps query failed with error: " + err, true);
+                }
+             } catch (InterruptedException | TimeoutException e) {
+                    printToScreen("Exception while retrieving query response: " + e.getMessage(), true);
+             }
+        } else {
+            printToScreen("Hardware CHRE link down or unavailable", true);
+        }
+    }
+
+    /* Creates a client to send messages to nanoapps
+     * and receive notifications through its callback */
+
+    private void registerContextHubClient() {
+        if (mContextHubManager == null || mContextHubInfo == null) {
+            printToScreen("Cannot create client: Context Hub Manager or Hub Info is null", true);
+            return;
+        }
+
+        mContextHubClientCallback = new ContextHubClientCallback() {
+            @Override
+            public void onMessageFromNanoApp(ContextHubClient client, NanoAppMessage message) {
+                printToScreen("Received message from nanoapp: " + message.toString(), false);
+
+                byte[] messageBody = message.getMessageBody();
+                if (messageBody != null) {
+                    printToScreen("Message body: " + new String(messageBody), false);
+                } else {
+                    printToScreen("Message body is empty/null", true);
+                }
+            }
+        };
+
+        mContextHubClient = mContextHubManager.createClient(mContextHubInfo, mContextHubClientCallback);
+
+        if (mContextHubClient == null) {
+            printToScreen("Context Hub client registration failed", true);
+        } else {
+            printToScreen("Context Hub client registration successed", false);
+        }
+    }
+
