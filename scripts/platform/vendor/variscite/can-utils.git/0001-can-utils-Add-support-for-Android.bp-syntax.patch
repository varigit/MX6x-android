+// Global compiler flags
+cc_defaults {
+    name: "can_utils_defaults",
+    cflags: [
+        "-O2",
+        "-g",
+        "-W",
+        "-Wall",
+        "-Wno-error=unused-parameter",
+        "-DSO_RXQ_OVFL=40",
+        "-DPF_CAN=29",
+        "-DAF_CAN=PF_CAN",
