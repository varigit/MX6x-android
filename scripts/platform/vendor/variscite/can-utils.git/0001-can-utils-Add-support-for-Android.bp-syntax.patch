 Android.bp | 327 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 327 insertions(+)
 create mode 100644 Android.bp

diff --git a/Android.bp b/Android.bp
new file mode 100644
index 0000000..c987cc5
--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,327 @@
